@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy policy";
}
<h1>@ViewData["Title"]</h1>

<p>
    This site does not collect any personal data.
</p>
<p>
    Currently, logging into the site does nothing apart from toggling the display of the login/logout links in the navigation bar. In the future, logging in may allow you to record which restaurants you have visited, but that functionality is not yet implemented. If you wish to help develop features like that, please visit the site's <a href="https://github.com/ploeh/fiftybest/">GitHub repository</a>.
</p>

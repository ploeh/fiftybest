@page "{country?}/{city?}"
@model Ploeh.FiftyBest.Pages.CitiesModel
@{
}

<div class="text-center">
    @if (Model.City is null)
    {
        <h1 class="display-4">Cities</h1>

        @foreach (var cid in Model.Cities)
        {
            <p><a asp-page="/Cities" asp-route-country="@cid.Country" asp-route-city="@cid.Name">@cid.Name</a></p>
        }
    }
    else
    {
        <h1 class="display-4">@Model.City, <a asp-page="/Countries" asp-route-country="@Model.Country">@Model.Country</a></h1>

        @foreach (var r in Model.Restaurants)
        {
            <p><a asp-page="/Restaurants" asp-route-country="@Model.Country" asp-route-city="@Model.City" asp-route-name="@r.Name">@r.Name</a></p>
        }
    }
</div>
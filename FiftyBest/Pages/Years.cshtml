@page "{year?}"
@model YearsModel
@{
    ViewData["Title"] = "Top Restaurants of " + Model.Year;
}

<div class="text-center">
    <h1 class="display-4">@Model.Year</h1>
</div>

<nav aria-label="Year navigation">
    <div class="d-flex align-items-center justify-content-center gap-3">
        @if (Model.PreviousYear is { })
        {
            <a class="btn btn-outline-primary" asp-page="/Years" asp-route-year="@(Model.PreviousYear)">&laquo;&nbsp;Previous</a>
        }
        else
        {
            <span class="btn btn-outline-secondary disabled">&laquo;&nbsp;Previous</span>
        }

        <select class="form-select" style="width: auto;" id="yearSelector" onchange="navigateToYear(this.value)">
            @foreach (var year in Model.Years)
            {
                <option value="@year" selected="@(year == Model.Year)">@year</option>
            }
        </select>

        @if (Model.NextYear is {})
        {
            <a class="btn btn-outline-primary" asp-page="/Years" asp-route-year="@(Model.NextYear)">Next&nbsp;&raquo;</a>
        }
        else
        {
            <span class="btn btn-outline-secondary disabled">Next&nbsp;&raquo;</span>
        }
    </div>
</nav>

<script>
function navigateToYear(year) {
    if (year) {
        window.location.href = '/Years/' + year;
    }
}
</script>

<table class="table">
    <thead>
        <tr>
            <th>Rank</th>
            <th>Restaurant</th>
            <th>City</th>
            <th>Country</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var entry in Model.Entries)
        {
            <tr>
                <td>@entry.Rank</td>
                <td><a asp-page="/Restaurants" asp-route-country="@entry.Country" asp-route-city="@entry.City" asp-route-name="@entry.Name.ToUrlSegment()">@entry.Name.Name</a></td>
                <td><a asp-page="/Cities" asp-route-country="@entry.Country" asp-route-city="@entry.City">@entry.City</a></td>
                <td><a asp-page="/Countries" asp-route-country="@entry.Country">@entry.Country</a></td>
            </tr>
        }
    </tbody>
</table>
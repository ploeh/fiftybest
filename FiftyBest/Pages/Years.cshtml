@page "{year?}"
@model YearsModel
@{
    ViewData["Title"] = "Top Restaurants of " + Model.Year;
}

<div class="text-center">
    <h1 class="display-4">@Model.Year</h1>
</div>

<nav aria-label="Year navigation">
    <ul class="pagination">
        @foreach (var year in Model.Years)
        {
            <li class="page-item @(year == Model.Year ? "active" : "")">
                <a class="page-link" asp-page="/Years" asp-route-year="@year">@year</a>
            </li>
        }
    </ul>
</nav>

<table class="table">
    <thead>
        <tr>
            <th>Year</th>
            <th>Rank</th>
            <th>Restaurant</th>
            <th>City</th>
            <th>Country</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var entry in Model.Entries)
        {
            <tr>
                <td>@Model.Year</td>
                <td>@entry.Rank</td>
                <td>@entry.Name</td>
                <td>@entry.City</td>
                <td>@entry.Country</td>
            </tr>
        }
    </tbody>
</table>
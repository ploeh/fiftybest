@page "{country?}/{city?}/{name?}"
@model Ploeh.FiftyBest.Pages.RestaurantsModel
@{
}

@if (Model.Name is {})
{
    <div class="text-center">
        <h1 class="display-4">@Model.Name.Name</h1>
        @if (Model.Aliases.Count > 0)
        {
            <p>@Model.Name.Name, AKA @string.Join(", ", Model.Aliases)</p>
        }
        <p><a asp-page="/Cities" asp-route-country="@Model.Country" asp-route-city="@Model.City">@Model.City</a>, <a asp-page="/Countries" asp-route-country="@Model.Country">@Model.Country</a></p>
    </div>

    <svg class="d-block w-100 mx-auto mb-3" style="max-width: 640px;" viewBox="0 0 640 300" role="img" aria-label="Rank by year">
        <g class="text-secondary" font-size="14">
            @foreach (var rank in Model.RankLabels)
            {
                <g>
                    <line x1="@Model.Left" y1="@Model.Y(rank)" x2="@Model.Right" y2="@Model.Y(rank)" stroke="currentColor" stroke-opacity="0.25" />
                    <text x="32" y="@Model.Y(rank)" dy="0.35em" text-anchor="end" fill="currentColor">@rank</text>
                </g>
            }
            @foreach (var year in Model.YearLabels)
            {
                <g>
                    <line x1="@Model.X(year)" y1="@Model.Y(1)" x2="@Model.X(year)" y2="@Model.Y(50)" stroke="currentColor" stroke-opacity="0.25" />
                    <text x="@Model.X(year)" y="285" text-anchor="middle" fill="currentColor">@year</text>
                </g>
            }
        </g>
        <g class="text-primary">
            @foreach (var segment in Model.Segments)
            {
                <line x1="@Model.X(segment.First.Year)" y1="@Model.Y(segment.First.Rank)" x2="@Model.X(segment.Second.Year)" y2="@Model.Y(segment.Second.Rank)" stroke="currentColor" stroke-width="2" />
            }
            @foreach (var ranking in Model.Rankings)
            {
                <circle cx="@Model.X(ranking.Year)" cy="@Model.Y(ranking.Rank)" r="4" fill="currentColor">
                    <title>@ranking.Year: @ranking.Rank</title>
                </circle>
            }
        </g>
    </svg>

    <table class="table">
        <thead>
            <tr>
                <th>Year</th>
                <th>Rank</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ranking in Model.Rankings)
            {
                <tr>
                    <td><a asp-page="/Years" asp-route-year="@ranking.Year">@ranking.Year</a></td>
                    <td>@ranking.Rank</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="text-center">
        <h1 class="display-4">Restaurants</h1>
        @foreach (var restaurant in Model.Restaurants)
        {
            <p><a asp-page="/Restaurants" asp-route-country="@restaurant.City.Country" asp-route-city="@restaurant.City.Name" asp-route-name="@restaurant.Name.ToUrlSegment()">@restaurant.Name.Name</a></p>
        }
    </div>
}